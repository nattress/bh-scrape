# Example environment configuration
# Copy this file to .env and customize the values

# Children to process (comma-separated)
BH_SCRAPE_CHILDREN=maira,george

# Directory to save downloaded files
BH_SCRAPE_SAVE_FOLDER=C:\Users\Simon\Dropbox\maira_in

# How many hours to look back for emails (default: 72)
BH_SCRAPE_LOOKBACK_HOURS=72

# Maximum retry attempts for failed operations (default: 3)
BH_SCRAPE_MAX_RETRIES=3

# Base delay between retries in milliseconds (default: 1000)
BH_SCRAPE_RETRY_DELAY_MS=1000

# Path to Google OAuth token file (default: ./token.json)
BH_SCRAPE_TOKEN_PATH=./token.json

# Path to Google OAuth credentials file (default: ./credentials.json)
BH_SCRAPE_CREDENTIALS_PATH=./credentials.json